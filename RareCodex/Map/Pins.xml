<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Frame name="RareCodexPinTemplate" mixin="RareCodexPinMixin" enableMouse="true" virtual="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="BACKGROUND">
                <!-- Pulsing glow while the rare was seen alive a moment ago -->
                <Texture parentKey="Glow" file="Interface\Cooldown\star4" alphaMode="ADD" hidden="true">
                    <Size x="44" y="44"/>
                    <Anchors>
                        <Anchor point="CENTER"/>
                    </Anchors>
                    <Color r="0.3" g="1" b="0.4"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <!-- Number of possible spawn points, empty when there is only one -->
                <FontString parentKey="Count" inherits="NumberFontNormalSmall">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="5" y="-3"/>
                    </Anchors>
                </FontString>
                <!-- Respawn countdown under the pin of a dead rare -->
                <FontString parentKey="Timer" inherits="GameFontHighlightSmallOutline">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="BOTTOM" y="-1"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <!-- Ping rings while the rare is hovered in the rare list. A child frame so they
                 draw above the neighbouring pins and do not take the mouse. -->
            <Frame parentKey="Ping" setAllPoints="true" hidden="true">
                <Layers>
                    <Layer level="OVERLAY">
                        <Texture parentKey="Ring1" file="Interface\AddOns\RareCodex\Media\ring" alphaMode="ADD">
                            <Size x="72" y="72"/>
                            <Anchors><Anchor point="CENTER"/></Anchors>
                            <Color r="1" g="0.82" b="0.1"/>
                        </Texture>
                        <Texture parentKey="Halo" file="Interface\Cooldown\star4" alphaMode="ADD">
                            <Size x="48" y="48"/>
                            <Anchors><Anchor point="CENTER"/></Anchors>
                            <Color r="1" g="0.85" b="0.2"/>
                        </Texture>
                    </Layer>
                </Layers>
                <Animations>
                    <!-- A ring growing from the pin and fading, like a minimap ping. -->
                    <AnimationGroup parentKey="Waves" looping="REPEAT">
                        <Scale childKey="Ring1" fromScaleX="0.25" fromScaleY="0.25" toScaleX="1" toScaleY="1" duration="1" order="1"/>
                        <Alpha childKey="Ring1" fromAlpha="1" toAlpha="0" duration="1" order="1"/>
                    </AnimationGroup>
                    <!-- And a steady glow behind the pin, breathing. -->
                    <AnimationGroup parentKey="Breath" looping="BOUNCE">
                        <Alpha childKey="Halo" fromAlpha="0.45" toAlpha="1" duration="0.5" order="1"/>
                    </AnimationGroup>
                </Animations>
            </Frame>
        </Frames>
        <Animations>
            <AnimationGroup parentKey="GlowPulse" looping="BOUNCE">
                <Alpha childKey="Glow" fromAlpha="0.35" toAlpha="1" duration="0.8" smoothing="IN_OUT"/>
            </AnimationGroup>
        </Animations>
        <!-- Only OnLoad here: the map canvas installs its own mouse scripts and asserts that
             pins define none. It then calls the mixin's OnMouseEnter/OnMouseLeave/click methods. -->
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
