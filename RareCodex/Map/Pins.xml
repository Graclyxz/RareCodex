<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Frame name="RareCodexPinTemplate" mixin="RareCodexPinMixin" enableMouse="true" virtual="true">
        <Size x="22" y="22"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <!-- Dragon above the icon of rare elites -->
                <Texture parentKey="EliteBadge" hidden="true">
                    <Size x="16" y="16"/>
                    <Anchors>
                        <Anchor point="BOTTOM" relativePoint="TOP" y="-6"/>
                    </Anchors>
                </Texture>
                <!-- Number of possible spawn points, empty when there is only one -->
                <FontString parentKey="Count" inherits="NumberFontNormalSmall">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" x="5" y="-3"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <!-- Only OnLoad here: the map canvas installs its own mouse scripts and asserts that
             pins define none. It then calls the mixin's OnMouseEnter/OnMouseLeave/click methods. -->
        <Scripts>
            <OnLoad method="OnLoad"/>
        </Scripts>
    </Frame>
</Ui>
